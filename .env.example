# ================================================================
#        فایل نمونه پیکربندی ربات فروش MS_VPN_BOT (MHPanel)
#  این فایل را به نام .env کپی کرده و مقادیر خود را در آن وارد کنید:
#       cp .env.example .env && nano .env
# ================================================================

# [الزامی] توکن ربات تلگرام دریافتی از @BotFather
TELEGRAM_TOKEN=123456789:ABCDefghIJKlmnoPQRstuvWXYZ

# [الزامی] یوزرنیم ربات تلگرام بدون علامت @
BOT_USERNAME=MyVpnBot

# [الزامی] کلید اختصاصی API پنل MHPanel (قابل کپی از منوی تنظیمات MHPanel)
PANEL_API_KEY=your_mhpanel_api_key_here

# [الزامی] آدرس وب‌سرویس API پنل MHPanel
PANEL_API_URL=https://mhpanel.example.com/api

# [الزامی] آدرس پایه‌ی دریافت لینک سابسکریپشن
PANEL_SUB_URL=https://mhpanel.example.com/sub

# [الزامی] شناسه عددی تلگرام مدیر یا مدیران (چند شناسه را با کاما جدا کنید)
ADMIN_ID=123456789
ADMIN_IDS=123456789

# آی‌پی عمومی سرور و نام دامنه
SERVER_IP=1.2.3.4
SERVER_DOMAIN=mhpanel.example.com

# رمز پیش‌فرض اتصالات پروتکل L2TP / IPsec (PSK)
IPSEC_PSK=123456789

# تنظیمات تانل SlowDNS / DNSTT
DNSTT_DOMAIN=t.vpn.example.com
DNSTT_PUBKEY=b3290012dd13fe7df78551fdfbccfdfce5d3c594522fef40bf8284e4313b3a31

# تنظیمات اکانت تستی خودکار (میزان حجم به گیگابایت و مدت زمان به روز)
TRIAL_TRAFFIC_GB=1.0
TRIAL_DURATION_DAYS=1

# اطلاعات کارت بانکی جهت دریافت هزینه اشتراک‌ها (کارت به کارت دستی)
CARD_NUMBER=6037990000000000
CARD_HOLDER=نام صاحب حساب

# درصد سود پورسانت سیستم رفرال و همکاری در فروش (درصد)
REFERRAL_PERCENT=10

# اطلاعات تماس و پشتیبانی
SUPPORT_ID=@YourSupportUsername
CHANNEL_LINK=https://t.me/YourChannelUsername

# مسیر ذخیره دیتابیس لوکال (اختیاری - پیش‌فرض data/bot.db)
# DB_PATH=/opt/ms-vpn-bot/data/bot.db
